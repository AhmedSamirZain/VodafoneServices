# =============================================================
# .env.example — انسخ الملف ده باسم .env واملأ القيم الحقيقية
# على Streamlit Cloud: حط نفس المتغيرات دي في تبويب "Secrets"
# ⚠️ لا ترفع ملف .env إلى جيت أبداً
# =============================================================
# البوت محتاج السِرّين دول بس — أي حاجة تحت "اختياري" ليها قيمة افتراضية.
# =============================================================


# ==================== السِرّين الإجباريين ====================

# 1) توكن البوت (من @BotFather)
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# 2) أرقام تليجرام الأدمن — واحد أو أكتر، مفصولة بفواصل أو مسافات
#    أول رقم = المطور الأساسي، والباقي أدمن بنفس الصلاحيات
ADMIN_IDS=111111111, 222222222


# ==================== اختياري (سيبها زي ما هي إلا لو محتاج) ====================

# مفتاح تشفير كلمات المرور (Fernet).
# سيبه فاضي → البوت هيشتق مفتاح ثابت من BOT_TOKEN أوتوماتيك (مفيش داعي تضيفه).
VAULT_KEY=

# اسم البوت للعرض في العناوين
BOT_NAME=VodafoneServices

# يوزر تليجرام بتاعك (عشان زرار "تواصل مع المطور") — مثال: DEV_USERNAME=@AhmedSamir
DEV_USERNAME=

# رقم استقبال فودافون كاش للاشتراكات (تقدر تغيّره وقت التشغيل من لوحة التحكم)
VODAFONE_CASH_NUMBER=

# تفعيل نظام الاشتراك المدفوع (True/False)
SUBSCRIPTION_ENABLED=True

# سعر الاشتراك الشهري بالجنيه
SUBSCRIPTION_PRICE=250

# اسم ملف قاعدة البيانات
DB_FILE=vodafoneservices.db

# حذف قاعدة البيانات عند كل تشغيل (خليها False)
DELETE_OLD_DB_ON_START=False

# اسم ملف سجل العمليات الحساسة
AUDIT_LOG_FILE=audit.log

# سر عميل تطبيق "أنا فودافون" — اختياري: سيبه فاضي والبوت هيستخدم البديل تلقائياً
VODA_CLIENT_ID=ana-vodafone-app
VODA_CLIENT_SECRET=
