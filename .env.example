# =============================================================
# .env.example — انسخ الملف ده باسم .env واملأ القيم الحقيقية
# على Streamlit Cloud: حط نفس المتغيرات دي في تبويب "Secrets"
# ⚠️ لا ترفع ملف .env إلى جيت أب أبداً
# =============================================================

# توكن بوت المستخدمين (من @BotFather)
USER_BOT_TOKEN=

# توكن بوت لوحة التحكم (من @BotFather) — لازم بوت تاني
ADMIN_BOT_TOKEN=

# ID المطور (رقمي) — مثال: 123456789
DEV_ID=0

# ID مساعد الإدارة (اختياري — سيبه 0 لو مفيش)
ASSISTANT_ADMIN_ID=0

# مفتاح تشفير كلمات المرور (Fernet) — ولّده بالأمر ده:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=

# رقم استقبال فودافون كاش للاشتراكات
VODAFONE_CASH_NUMBER=

# تفعيل نظام الاشتراك المدفوع (True/False)
SUBSCRIPTION_ENABLED=True

# سعر الاشتراك الشهري بالجنيه
SUBSCRIPTION_PRICE=250

# اسم ملف قاعدة البيانات
DB_FILE=spartan_new.db

# حذف قاعدة البيانات عند كل تشغيل (خليها False)
DELETE_OLD_DB_ON_START=False
